# ==============================================================================
# Weto Next.js Full-Stack — Environment Configuration
# Copy this file to .env.local (for local development) and fill in your secrets.
# Never commit real secrets to version control.
# ==============================================================================

# --- Application ---
NEXT_PUBLIC_APP_NAME=Weto
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=2.1.0
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_HIDE_AUTHOR_ATTRIBUTION=false

# Salt used for Hashids (publication & listing short IDs)
HASHIDS_SALT=change-me-to-a-long-random-string
# Internal secret for signing auxiliary CSRF / session / webhook state
APP_SECRET=change-me-to-a-64-char-random-hex-secret
# Master system API key (for /api/v1/system/* endpoints)
SYSTEM_API_KEY=change-me-system-api-key
# Comma-separated usernames new users auto-follow after onboarding
AUTO_FOLLOW_LIST=

# --- MongoDB Atlas (Primary Database; Replica Set required for ACID transactions) ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/colibriplus?retryWrites=true&w=majority
MONGODB_DB_NAME=colibriplus

# --- Redis (BullMQ Worker, Socket.IO Adapter/Emitter, Rate Limiting, Cache) ---
REDIS_URL=redis://localhost:6379

# --- Firebase Client SDK (Public Browser Config) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin SDK (Server-Side ONLY — NEVER expose to client) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Replace literal newlines with \n when storing in single-line .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudflare R2 (S3-Compatible Primary Media Storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=weto-media
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Public CDN domain mapped to the R2 bucket (for public avatars, posts, marketplace)
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.example.com

# --- Real-Time Infrastructure (Standalone Socket.IO Server) ---
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
REALTIME_PORT=4000
REALTIME_CORS_ORIGIN=http://localhost:3000

# --- Media Processing Worker (BullMQ + FFmpeg) ---
# Set ENABLE_MEDIA_WORKER=true ONLY when running worker/index.ts externally.
# On Vercel serverless without a persistent worker, leave false/unset so uploads complete immediately.
ENABLE_MEDIA_WORKER=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TEMP_DIR=./tmp/media

# --- Vercel Cron Security ---
# Secret automatically sent as Authorization: Bearer <CRON_SECRET> by Vercel Cron Jobs
CRON_SECRET=

# --- Payment Gateways (Server-Side Defaults; also configurable in Admin Panel) ---
# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# YooKassa (Optional Regional Gateway)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# RoboKassa (Optional Regional Gateway)
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASS_ONE=
ROBOKASSA_PASS_TWO=
ROBOKASSA_TEST_MODE=true

# --- Email (SMTP via Nodemailer; also configurable in Admin Panel) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Weto
ADMIN_ALERT_EMAIL=admin@example.com

# --- External Services & Integrations ---
# Giphy
NEXT_PUBLIC_GIPHY_API_KEY=
GIPHY_API_KEY=

# IP Geolocation (IPInfo)
IPINFO_TOKEN=

# Post / Message Translation (LibreTranslate)
TRANSLATION_SERVICE=libretranslate
TRANSLATION_SERVICE_API_URL=http://localhost:5000
TRANSLATION_SERVICE_API_KEY=

# SMS Provider (log | vonage | smsaero)
SMS_DRIVER=log
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Weto
SMSAERO_EMAIL=
SMSAERO_API_KEY=

# AI Greeting / Assistant (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=

# Identity Verification Provider URL
VERIFICATION_SERVICE_URL=https://docs.sumsub.com/docs/user-verification

# --- MySQL Migration Source (Phase 5 Data Migration CLI ONLY) ---
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_DATABASE=colibri_plus
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=
LEGACY_STORAGE_PATH=../Source/storage/app/public
