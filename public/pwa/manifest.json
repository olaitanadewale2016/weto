{
  "id": "weto-app",
  "name": "Weto",
  "short_name": "Weto",
  "description": "Modern Social Media Sharing Platform",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#4A5CF9",
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "New Post",
      "short_name": "New Post",
      "url": "/new/post"
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "url": "/messenger"
    },
    {
      "name": "Marketplace",
      "short_name": "Marketplace",
      "url": "/marketplace"
    }
  ],
  "icons": [
    {
      "src": "/pwa/icons/192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icons/192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa/icons/512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icons/512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
