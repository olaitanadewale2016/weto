		"NEXT_PUBLIC_FIREBASE_PROJECT_ID": "weto-5369a",
		"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "weto-5369a.firebasestorage.app",
		"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "894452415589",
		"NEXT_PUBLIC_FIREBASE_APP_ID": "1:894452415589:web:de5e32998667fe84551a8c",
